# Reference values for native (non-Docker) backend runs.
# Django does not read this file automatically; export the variables in your
# shell or copy the root .env.example for docker compose.
#
# PowerShell example:
#   $env:DJANGO_DEBUG="true"
#   .\.venv\Scripts\python.exe manage.py runserver 0.0.0.0:8000

DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000
PUBLIC_API_BASE_URL=/api/v1

# Leave DATABASE_URL empty for the zero-config SQLite demo.
DATABASE_URL=
# DATABASE_URL=postgresql://homs:password@127.0.0.1:5432/homs
# SQLITE_PATH=C:\path\to\db.sqlite3

DJANGO_LOG_LEVEL=INFO
DJANGO_LOG_FILE=
DJANGO_MEDIA_ROOT=
DJANGO_STATIC_ROOT=

# Explicit origin allowlist; include every actual Vercel production/preview
# origin that should access this backend, separated by commas. No wildcard.
# For local + deployed clients together, use:
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://<actual-vercel-domain>
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOW_CREDENTIALS=true
# Django admin/session requests still require CSRF. Browser JWT API requests
# use Authorization headers, not authentication cookies.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://<actual-vercel-domain>
JWT_ACCESS_MINUTES=480
JWT_REFRESH_DAYS=7
# See docs/AUTHENTICATION_DEPLOYMENT.md for identity-source and hosting setup.

# Render deployment (keep existing secrets and DATABASE_URL):
# DJANGO_DEBUG=false
# RENDER_EXTERNAL_HOSTNAME is supplied automatically by Render.
# DJANGO_ALLOWED_HOSTS=demo-jpuo.onrender.com
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://frontend-lake-three-pu8rw4cxw9.vercel.app
# DJANGO_CSRF_TRUSTED_ORIGINS=https://frontend-lake-three-pu8rw4cxw9.vercel.app
# FRONTEND_BASE_URL=https://frontend-lake-three-pu8rw4cxw9.vercel.app
# RUN_MIGRATIONS=0
# DJANGO_MEDIA_ROOT=/app/media
# See docs/RENDER_SETUP.md (repository root).

# PUBLIC_API_BASE_URL=https://demo-jpuo.onrender.com/api/v1
