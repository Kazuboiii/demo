# Copy this file to .env before running Docker Compose.
# Never commit the real .env file.
#
# Local demo (HTTP):
#   DJANGO_DEBUG=true
#   DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
#   DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
#   CORS_ALLOWED_ORIGINS=http://localhost:3000
#   FRONTEND_BASE_URL=http://localhost:3000
#
# Production (HTTPS) example:
#   APP_ENV=production
#   DJANGO_DEBUG=false
#   DJANGO_ALLOWED_HOSTS=example.com,api.example.com
#   DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
#   CORS_ALLOWED_ORIGINS=https://example.com
#   FRONTEND_BASE_URL=https://example.com
#   PUBLIC_API_BASE_URL=https://api.example.com/api/v1
#   DJANGO_SECURE_SSL_REDIRECT=true

APP_ENV=production
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=example.com,api.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
CORS_ALLOWED_ORIGINS=https://example.com
FRONTEND_BASE_URL=https://example.com
PUBLIC_API_BASE_URL=https://api.example.com/api/v1

# PostgreSQL used by docker-compose. URL-encode special characters in the
# password when DATABASE_URL is assembled by Compose.
POSTGRES_DB=homs
POSTGRES_USER=homs
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# Database override for native (non-Docker) runs. Leave empty to use SQLite.
# DATABASE_URL=postgresql://homs:password@127.0.0.1:5432/homs
# SQLITE_PATH=/absolute/path/to/db.sqlite3

# JWT and API tuning
JWT_ACCESS_MINUTES=480
JWT_REFRESH_DAYS=7
API_PAGE_SIZE=20
ROTATING_QR_VALIDITY_SECONDS=30
ONE_TIME_QR_DEFAULT_VALIDITY_MINUTES=5

# Logging: console by default; set DJANGO_LOG_FILE for rotating file logs.
DJANGO_LOG_LEVEL=INFO
DJANGO_LOG_FILE=
DJANGO_LOG_MAX_BYTES=10485760
DJANGO_LOG_BACKUPS=5

# Storage
DJANGO_STATIC_URL=/static/
DJANGO_MEDIA_URL=/media/
# DJANGO_STATIC_ROOT=/app/staticfiles
# DJANGO_MEDIA_ROOT=/app/media
# DJANGO_STORAGE_BACKEND=storages.backends.s3.S3Storage

# Compose ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
GUNICORN_WORKERS=3
RUN_MIGRATIONS=1

# Frontend build/runtime. Leave NEXT_PUBLIC_API_BASE_URL empty to use the
# same-origin proxy (recommended). API_PROXY_TARGET is only used at build time.
NEXT_PUBLIC_API_BASE_URL=
API_PROXY_TARGET=http://backend:8000
